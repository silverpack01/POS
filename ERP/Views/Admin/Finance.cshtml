@{
    ViewBag.Title = "Finance";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<div class="container-fluid fin-wrap">

    <div class="fin-header">
        <div class="fin-header-left">
            <span class="fin-icon">
                <svg viewBox="0 0 576 512" width="22" height="22" fill="currentColor"><path d="M0 112.5V422.3c0 18 10.1 35.7 27.6 44.9c22.3 11.7 46.7 21.6 68.9 25.9c26.3 5.2 53.7-4.4 71.6-24.4c1.6-1.8 3-3.7 4.3-5.7c14.6 9.5 32 15 50.6 15c22.4 0 43-8 59-21.3c15.9 13.3 36.6 21.3 59 21.3s43.1-8 59-21.3c16 13.3 36.6 21.3 59 21.3c18.6 0 36-5.5 50.6-15c1.3 2 2.7 3.9 4.3 5.7c17.9 20 45.3 29.6 71.6 24.4c22.2-4.3 46.6-14.2 68.9-25.9c17.5-9.2 27.6-26.9 27.6-44.9V112.5c0-27.6-19.5-51.4-46.6-56.8L338.4 25.4C289.6-8.5 236.4-8.5 187.6 25.4z" /></svg>
            </span>
            <div>
                <h4 class="fin-title">Finance Management</h4>
                <p class="fin-subtitle">Accounts Head / Payment Voucher / Janaeral Voucher / Ledgers & Chart of Account. </p>
            </div>
        </div>
        <nav class="fin-breadcrumb" aria-label="breadcrumb">
            <span>Home</span>
            <span class="fin-crumb-sep">/</span>
            <span class="fin-crumb-current">Finance</span>
        </nav>
    </div>

    <div class="dash-shell">
        <div class="mro">

            <a href="/Accounts/Head" class="tile bb">
                <div class="tile-icon"><img src="~/images/one.png" class="img-fluid" alt="" /></div>
                <p>1st Head Account</p>
            </a>

            <a href="/Accounts/SubHeadList" class="tile bb">
                <div class="tile-icon"><img src="~/images/2.png" class="img-fluid" alt="" /></div>
                <p>2nd Head Account</p>
            </a>

            <a href="/Accounts/SubSubHeadList" class="tile bb">
                <div class="tile-icon"><img src="~/images/3.png" class="img-fluid" alt="" /></div>
                <p>3rd Head Account</p>
            </a>

            <a href="/Accounts/SubSubSubHeadList" class="tile bb">
                <div class="tile-icon"><img src="~/images/four.png" class="img-fluid" alt="" /></div>
                <p>4th Head Account</p>
            </a>

            <a href="/Accounts/AccountRegList" class="tile">
                <div class="tile-icon"><img src="~/images/plus-sign.png" class="img-fluid" alt="" /></div>
                <p>New Account</p>
            </a>

            <a href="@Url.Action("ChartOfAccounts", "Accounts")" class="tile bb">
                <div class="tile-icon"><img src="~/images/balance-sheet.png" class="img-fluid" alt="" /></div>
                <p>Chart of Account</p>
            </a>

            <a href="/Voucher/PaymentVoucher" class="tile">
                <div class="tile-icon"><img src="~/images/payment.png" class="img-fluid" /></div>
                <p>Cash P / R</p>
            </a>

            <a href="@Url.Action("ReceivingVoucher", "Voucher")" class="tile receiving-voucher-tile">
                <div class="tile-icon"><i class="fa fa-exchange" aria-hidden="true"></i></div>
                <p>Receiving Voucher</p>
            </a>

            <a href="@Url.Action("PaymentCreditVoucher", "Voucher")" class="tile receiving-voucher-tile">
                <div class="tile-icon"><i class="fa fa-credit-card" aria-hidden="true"></i></div>
                <p>Payment Voucher</p>
            </a>

            <a href="@Url.Action("Voucher", "Voucher", new {head="Journal Voucher",type="JV"})" class="tile">
                <div class="tile-icon"><img src="~/images/accounting.png" class="img-fluid" /></div>
                <p>Jeneral Voucher</p>
            </a>



        </div>
    </div>
</div>

<style>
    
    :root {
        --dash-primary: #1b2a4a;
        --dash-primary-dark: #16233d;
        --dash-accent: #2f6fed;
        --dash-bg: #F4F7FB;
        --dash-border: #e7ecf3;
        --dash-danger: #d64545;
        --dash-text-muted: #6b7c95;
    }

    .fin-wrap {
        padding-top: 6px;
        padding-bottom: 24px;
    }

    /* ---------- Page header ---------- */
    .fin-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 18px;
    }

    .fin-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .fin-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, var(--dash-primary) 0%, var(--dash-accent) 100%);
        box-shadow: 0 6px 16px rgba(27, 42, 74, 0.28);
    }

    .fin-title {
        margin: 0;
        font-weight: 800;
        font-size: 1.35rem;
        color: var(--dash-primary);
        letter-spacing: .2px;
    }

    .fin-subtitle {
        margin: 2px 0 0;
        font-size: 0.85rem;
        color: var(--dash-text-muted);
    }

    .fin-breadcrumb {
        font-size: 0.82rem;
        color: var(--dash-text-muted);
        font-weight: 600;
    }

    .fin-crumb-sep {
        margin: 0 6px;
        opacity: .6;
    }

    .fin-crumb-current {
        color: var(--dash-primary);
    }

    /* ---------- Shell ---------- */
    .dash-shell {
        background-color: var(--dash-bg);
        border: 1px solid var(--dash-border);
        border-radius: 16px;
        box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.05), 0 6px 20px 0 rgba(0, 0, 0, 0.05);
        padding: 22px;
    }

    /* ---------- Sidebar menu (kept for reuse elsewhere) ---------- */
    .dash-menu {
        margin-top: 6px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .menu-block {
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(20, 30, 60, 0.06);
    }

    .menu-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        font-weight: 700;
        font-size: 0.95rem;
        color: #fff;
        background: linear-gradient(135deg, var(--dash-primary) 0%, var(--dash-primary-dark) 100%);
        text-decoration: none;
        transition: filter 0.15s ease;
    }

        .menu-trigger:hover,
        .menu-trigger:focus {
            color: #fff;
            filter: brightness(1.08);
            text-decoration: none;
        }

        .menu-trigger .chevron {
            transition: transform 0.2s ease;
            font-size: 0.8rem;
        }

        .menu-trigger[aria-expanded="true"] .chevron {
            transform: rotate(180deg);
        }

    .menu-sublist {
        display: flex;
        flex-direction: column;
        padding: 8px;
        gap: 4px;
    }

    .menu-sublink {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.88rem;
        color: var(--dash-primary);
        text-decoration: none;
        transition: background 0.15s ease, transform 0.15s ease;
    }

        .menu-sublink:hover {
            background: #eef1ff;
            color: var(--dash-primary);
            transform: translateX(2px);
            text-decoration: none;
        }

        .menu-sublink i {
            font-size: 0.75rem;
            opacity: 0.75;
        }

    /* ---------- Tile grid ---------- */
    .mro {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .tile {
        background: #ffffff;
        border: 1px solid var(--dash-border);
        border-radius: 14px;
        padding: 24px 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-decoration: none;
        color: #24304a;
        box-shadow: 0 2px 6px rgba(20, 30, 60, 0.06);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

        .tile:hover,
        .tile:focus {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(27, 42, 74, 0.14);
            border-color: var(--dash-accent);
            color: #24304a;
            text-decoration: none;
            background: #fbfcff;
        }

        .tile:active {
            transform: translateY(-1px) scale(0.98);
        }

    .tile-icon {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        background: linear-gradient(135deg, #eef2fb 0%, #e4ecfc 100%);
    }

        .tile-icon img {
            max-width: 26px;
            max-height: 26px;
            width: 100%;
            object-fit: contain;
        }

    .tile p {
        font-size: 0.86rem;
        font-weight: 700;
        margin: 0;
        line-height: 1.25;
        color: var(--dash-primary);
    }

    .tile-danger p {
        color: var(--dash-danger);
    }

    .receiving-voucher-tile .tile-icon {
        background: #234c6a;
    }

    .receiving-voucher-tile .tile-icon i {
        color: #fff;
        font-size: 26px;
    }

    /* ---------- Responsive breakpoints ---------- */
    @@media (max-width: 992px) {
        .mro {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .fin-header {
            align-items: flex-start;
        }

        .fin-breadcrumb {
            display: none;
        }

        .fin-title {
            font-size: 1.15rem;
        }

        .fin-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 10px;
        }

        .dash-shell {
            padding: 14px;
            border-radius: 12px;
        }

        .mro {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .tile {
            padding: 16px 8px;
            border-radius: 12px;
        }

        .tile-icon {
            width: 42px;
            height: 42px;
        }

            .tile-icon img {
                max-width: 22px;
                max-height: 22px;
            }

        .tile p {
            font-size: 0.78rem;
        }

        .menu-trigger {
            font-size: 0.88rem;
            padding: 12px 14px;
        }

        .menu-sublink {
            font-size: 0.85rem;
        }
    }

    @@media (max-width: 360px) {
        .mro {
            grid-template-columns: repeat(1, 1fr);
        }
    }
    /*.bb {
        display: none;
    }*/
</style>
