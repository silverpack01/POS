
@{
    ViewBag.Title = "AllStock";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<div class="container-fluid">
    <section class="mt-2">
        <div class="row">
            <div class="col-md-4 col-7 mb-2">
                <p style="font-weight: bold; font-size: 28px; color: #1b2a4a"> Profit % on Item</p>
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-primary form-control" onclick="exportTableToExcel('ptbl', 'Stock_Report')">Excel</button>
            </div>
            <div class="col-md-3 col-sm-8 col-7 mb-2">
                <input type="text" class="form-control  form-control-sm sc" id="MyInput2" onkeyup="myFunction2()" placeholder="Search By Item" />
            </div>
            <div class="col-md-3 col-sm-6 col-12 mb-2" id="grid">
                <select class="form-control form-control-sm sc" id="dis" onchange="discountChange()">
                    <option value=""> Search Profit % </option>
                    <option value="10">1% -- 10% </option>
                    <option value="20"> 11% -- 20% </option>
                    <option value="30"> 21% -- 30% </option>
                    <option value="40"> 31% -- 40% </option>
                    <option value="50"> 41% -- 50% </option>
                    <option value="60"> 51% -- 60% </option>
                    <option value="70"> 61% -- 70% </option>
                    <option value="80"> 71% -- 80% </option>
                    <option value="90"> 81% -- 90% </option>
                    <option value="100"> 91% -- 100% </option>
                    <option value=""> Clear All </option>
                </select>
            </div>
        </div>
    </section>
    <section>
        <table class="table table-sm table-bordered table-hover" id="ptbl">
            <thead>
                <tr style="background-color: #077A7D" class="text-white">
                    <td style="background-color: #2c3e63; width: 30%" class="text-white"><b>Item</b></td>
                    <td style="background-color: #2c3e63; width: 8%" class="text-white bb"><b>Colour</b></td>
                    <td style="background-color: #2c3e63; width: 8%" class="text-white bb"><b>Size</b></td>
                    <td style="background-color: #2c3e63; width: 20%" class="text-white bb"><b>Rate</b></td>
                    <td style="background-color: #2c3e63; width: 13%" class="text-white bb"><b>Packing</b></td>
                    <td style="background-color: #2c3e63; width: 8%" class="text-white"><b>Per(%)</b></td>
                </tr>
            </thead>
            <tbody class="pbody" id="pp"></tbody>
        </table>
        <div id="paginationContainer" class="mt-3"></div>
    </section>
</div>
<style>
    .abb {
        display: none;
    }

    .ss {
        border: 2px solid #077A7D;
        background-color: #f9f9f9;
    }

    .sc {
        border: 2px solid #077A7D;
        background-color: #f9f9f9;
    }

    table thead tr td {
        font-size: 12px;
    }

    table tbody tr td {
        font-size: 12px;
        font-weight: bold;
    }

    @@media (max-width: 600px) {
        #MyInput2,
        #rsid,
        #ssid {
            font-size: 14px;
        }

        .sc {
            width: 100%;
        }

        .btn {
            font-size: 14px;
        }

        p {
            font-size: 22px !important;
            text-align: center;
        }

        .bb {
            display: none;
        }

        .abb {
            display: flex;
        }
    }
</style>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
<link href="~/Content/KendoUI/default-ocean-blue.css" rel="stylesheet" />
<script src="~/Content/KendoUI/jszip.min.js"></script>
<script src="~/Content/KendoUI/kendo.all.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>
<script>
    $(document).ready(function () {
        loadData();
        
    });
    

    function discountChange() {
        var selected = parseFloat($('#dis').val());

        if (isNaN(selected)) {
            // "Search Profit %" ya "Clear All" -> sara data wapas dikhao
            filteredProducts = allProducts;
        } else {
            var lowerLimit = selected - 9; // selected value minus 9

            filteredProducts = allProducts.filter(function (item) {
                var cost = parseFloat(item.CostRate) || 0;
                var sale = parseFloat(item.SaleAmt) || 0;
                var percent = cost > 0 ? ((sale - cost) / cost) * 100 : 0;

                return percent >= lowerLimit && percent <= selected;
            });
        }

        currentPage = 1;   // filter change hote hi page 1 pe reset
        renderTable();
        renderPagination();
    }



    
    var allProducts = [];
    var filteredProducts = [];   // search ke baad ka data
    var currentPage = 1;
    var pageSize = 50;

    function loadData() {
        var id = 1;
        var empObj = {
            Id: id,
        };
        $.ajax({
            url: "/Product/ProductList",
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                allProducts = result;
                filteredProducts = result;   // shuru mein filter empty hota hai
                currentPage = 1;
                renderTable();
                renderPagination();
            },
            error: function (errormessage) {
                //alert(errormessage.responseText);
            }
        });
    }

    function renderTable() {
        var html = '';
        $('.pbody').html("");

        var startIndex = (currentPage - 1) * pageSize;
        var endIndex = startIndex + pageSize;
        var pageData = filteredProducts.slice(startIndex, endIndex);   // filteredProducts use karo

        $.each(pageData, function (key, item) {

            let stock = parseInt(item.Stock) || 0;
            let limit = parseInt(item.StockLimit) || 0;
            let cost = parseFloat(item.CostRate) || 0;
            let sale = parseFloat(item.SaleAmt) || 0;
            let samt = cost * stock;
            let percent = cost > 0 ? ((sale - cost) / cost) * 100 : 0;

            // row color logic
            let bgColor = '';
            if (stock <= limit && stock > 0) {
                bgColor = 'background-color:#1993ee41;';
            }
            else if (stock == 0) {
                bgColor = 'background-color:rgba(230,226,36,0.56);';
            }
            else if (stock < 0) {
                bgColor = 'background-color:rgba(250,65,39,0.57);';
            }
            html += `
        <tr style="${bgColor} cursor:pointer" onclick="Ledger(${item.Id})">
            <td class="aa bb" style="display:none;font-weight:bold">${item.Barcode}</td>
            <td class="aa" style="font-weight:bold">
                ${item.BatchNo} - ${item.Item}
            </td>
            <td class="aa bb" style="font-weight:bold">${item.Colour}</td>
            <td class="aa bb" style="font-weight:bold">${item.Size}</td>
            <td class="aa bb" style="font-weight:bold">
                ${item.CostRate} / ${item.SaleAmt}
            </td>
            <td class="aa bb" style="font-weight:bold">1 x ${item.UnitPack}</td>
            <td class="aa" style="font-weight:bold;color:#ea0f0f;">${percent.toFixed(2)} %</td>
        </tr>`;
        });

        $('.pbody').html(html);
        sum();
    }

    function renderPagination() {
        var totalRecords = filteredProducts.length;   // filteredProducts use karo
        var totalPages = Math.ceil(totalRecords / pageSize);

        if (totalRecords <= pageSize) {
            $('#paginationContainer').html('');
            return;
        }

        var isMobile = $(window).width() < 768;
        var maxVisible = isMobile ? 3 : 10;

        var windowIndex = Math.floor((currentPage - 1) / maxVisible);
        var startPage = windowIndex * maxVisible + 1;
        var endPage = Math.min(startPage + maxVisible - 1, totalPages);

        var html = '<ul class="pagination flex-wrap">';

        html += '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="goToPage(' + (currentPage - 1) + ');return false;">Prev</a></li>';

        for (var i = startPage; i <= endPage; i++) {
            html += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '">' +
                '<a class="page-link" href="#" onclick="goToPage(' + i + ');return false;">' + i + '</a></li>';
        }

        html += '<li class="page-item ' + (currentPage === totalPages ? 'disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="goToPage(' + (currentPage + 1) + ');return false;">Next</a></li>';

        html += '</ul>';

        $('#paginationContainer').html(html);
    }

    function goToPage(page) {
        var totalPages = Math.ceil(filteredProducts.length / pageSize);
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        renderTable();
        renderPagination();
    }

    $(window).on('resize', function () {
        if (allProducts.length > 0) {
            renderPagination();
        }
    });

    // ===== Search Function (updated) =====
    function myFunction2() {
        var input = document.getElementById("MyInput2");
        var filter = input.value.toUpperCase().trim();

        if (filter === "") {
            // Search khali ho to sara data wapas dikhao
            filteredProducts = allProducts;
        } else {
            // Har item ke tamam fields (Item, Barcode, Colour, Size, Rate,
            // Discount, SaleAmt, Category, Rack, Location, waghera) me se
            // kisi bhi field me match dhoondein — generic, koi field
            // hardcode nahi kiya taake naye columns add hone par bhi
            // search apne aap kaam karta rahe.
            filteredProducts = allProducts.filter(function (item) {
                for (var key in item) {
                    if (!item.hasOwnProperty(key)) continue;
                    var value = item[key];
                    if (value === null || value === undefined) continue;
                    if (String(value).toUpperCase().indexOf(filter) > -1) {
                        return true;
                    }
                }
                return false;
            });
        }

        currentPage = 1;   // search karte hi page 1 pe reset
        renderTable();
        renderPagination();
    }
    function sum() {
        var grandT = 0;

        $("#ptbl > tbody > tr:visible").each(function () {
            var t10 = $(this).find('td').eq(9).text().trim();

            t10 = t10.replace('%', ''); // agar % ho

            if (!isNaN(t10) && t10 !== '') {
                grandT += parseFloat(t10);
            }
        });

        $(".tvalue").text(grandT.toFixed(2));
    }
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputs = document.querySelectorAll(".ss");

        inputs.forEach(input => {
            input.addEventListener("input", function () {
                if (input.value.trim() !== "") {
                    input.style.border = "2px solid green"; // new border
                } else {
                    input.style.border = "2px solid #077A7D"; // original
                }
            });
        });
    });
    
    function exportTableToExcel(tableID, filename) {
        const table = document.getElementById(tableID);
        const wb = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

        // Modify date cells to use custom number format
        const ws = wb.Sheets.Sheet1;
        for (const cell in ws) {
            if (cell.startsWith('C') && ws[cell].t === 'd') {
                ws[cell].z = 'dd/mm/yyyy'; // Custom number format
            }
        }

        // Generate the XLSX file
        const wbout = XLSX.write(wb, { bookType: "xlsx", type: "array" });

        // Convert to Blob and create a download link
        const blob = new Blob([wbout], { type: "application/octet-stream" });
        const url = URL.createObjectURL(blob);

        // Create a download link and trigger the download
        const a = document.createElement("a");
        a.href = url;
        a.download = `${filename}.xlsx`;
        a.click();

        // Clean up
        setTimeout(() => {
            URL.revokeObjectURL(url);
        }, 100);
    };
</script>

