@model ERPSolution.Models.TblUnit
@{
    ViewBag.Title = " Product Unit";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<div class="container">
    <section>
        <div class="row">
            <div class="col-md-9">
                <p style="font-weight: bold; color: #1b2a4a">Create Measurment Unit</p>
            </div>
        </div>
    </section>
    <section class="mt-4 shadow p-2">
        <div class="row">
            <div class="col-md-10">
                <label><b>Unit Name:</b></label>
                @Html.TextBoxFor(x => x.UnitName, new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <input type="submit" class="btn form-control" value="Save Unit" style="background-color: #1b2a4a; color: white; margin-top: 24px" onclick="SaveUnit()" />
            </div>
        </div>
    </section>
    <section>
        <table class="table table-sm table-bordered table-hover">
            <thead>
                <tr style="background-color: #1b2a4a" class="text-white">
                    <td style="background-color: #1b2a4a; width: 15%" class="text-white"><b>ID</b></td>
                    <td style="background-color: #1b2a4a; width: 65%" class="text-white"><b>Unit</b></td>
                    <td style="background-color: #1b2a4a; width: 20%" class="text-white"><b>XXX</b></td>
                </tr>
            </thead>
            <tbody class="ubody"></tbody>
        </table>
    </section>
</div>
<style>
    p {
        font-size: 28px;
    }

    thead tr td {
        font-size: 14px;
    }

    tbody tr td {
        font-size: 16px;
        font-weight: bold;
    }

    @@media(max-width: 600px) {
        p {
            font-size: 18px;
        }
    }
</style>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>

<link href="~/Content/KendoUI/default-ocean-blue.css" rel="stylesheet" />
<script src="~/Content/KendoUI/jszip.min.js"></script>
<script src="~/Content/KendoUI/kendo.all.min.js"></script>
<script>
    $(document).ready(function () {
        //alert();
        loadData();
    });
    function SaveUnit() {
        //alert();
        let UnitName = $("#UnitName").val().trim();
        if (UnitName.length != 0) {
            var empObj = {
                UnitName: UnitName
            };
            //alert(Barcode + "---" + _saleid + "---" + itemdis + "---" + rate + "---" + qty);
            $.ajax({
                url: "/Product/AddNewUnit/",
                data: JSON.stringify(empObj),
                type: "POST",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    $("#UnitName").val('');
                    loadData();
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }
            });
        } else {
            alert("Enter Rack Name");
        }
    };
    function loadData() {
        var id = 1;
        var empObj = {
            Id: id,
        };
        $.ajax({
            url: "/Product/UnitList",
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                var html = '';
                $.each(result, function (key, item) {
                    html += '<tr>';
                    html += '<td class="aa" style="font-weight:bold">' + item.Id + '</td>';
                    html += '<td class="aa" style="font-weight:bold">' + item.UnitName + '</td>';
                    html += '<td class="divhi"> <a href="#" class="btn btn-sm btn-danger" onclick="DeleleNew(' + item.Id + ')">X</a></td>';
                    html += '</tr>';
                });
                $('.ubody').html(html);
            },
            error: function (errormessage) {
                //alert(errormessage.responseText);
            }
        });
    };
    function DeleleNew(ID) {
        var ans = confirm("Are you sure you want to delete this Record?");
        if (ans) {
            $.ajax({
                url: "/Product/DeleteUnit/" + ID,
                type: "POST",
                contentType: "application/json;charset=UTF-8",
                dataType: "json",
                success: function (result) {
                    loadData();
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }
            });
        }
    };
</script>

