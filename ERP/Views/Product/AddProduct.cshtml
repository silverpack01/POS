<script>
    $(document).ready(function () {
        function calculateDiscount() {
            let saleRate = parseFloat($("#SaleRate").val()) || 0;
            let disPer = parseFloat($("#DisPer").val()) || 0;
            //alert(saleRate + "---" + disPer);
            if (!isNaN(disPer)) {
                let disAmt = (saleRate * disPer / 100).toFixed(2);
                let saleAmt = (saleRate - disAmt).toFixed(2);

                $("#DisAmt").val(disAmt);
                $("#SaleAmt").val(saleAmt);
            } else {
                // No discount percentage, show sale rate as sale amount
                $("#DisAmt").val(0);
                $("#DisPer").val(0);
                $("#SaleAmt").val(saleRate.toFixed(2));
            }
        };
        function calculateDiscount2() {
            let saleRate = parseFloat($("#SaleRate").val()) || 0;
            let disamt = parseFloat($("#DisAmt").val()) || 0;
            //alert(saleRate + "---" + disPer);
            if (!isNaN(disamt)) {
                let disPer = (disamt / saleRate * 100).toFixed(2);
                let saleAmt = (saleRate - disamt).toFixed(2);

                $("#DisPer").val(disPer);
                $("#SaleAmt").val(saleAmt);
            } else {
                // No discount percentage, show sale rate as sale amount
                $("#DisAmt").val(0);
                $("#DisPer").val(0);
                $("#SaleAmt").val(saleRate.toFixed(2));
            }
        };
        function calculateSingle() {
            let saleRate = parseFloat($("#SaleRate").val()) || 0;
            $("#DisAmt").val(0);
            $("#DisPer").val(0);
            $("#SaleAmt").val(saleRate.toFixed(2));
        }

        // Trigger calculation when SaleRate or DisPer changes
        $("#SaleRate").on('input', calculateSingle);
        $("#DisPer").on('input', calculateDiscount);
        $("#DisAmt").on('input', calculateDiscount2);
    });
</script>




