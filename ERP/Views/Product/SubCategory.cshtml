@model ERPSolution.Models.TblSubCategory
@{
    ViewBag.Title = "Sub Category";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<link href="~/Content/font-awesome.css" rel="stylesheet" />
<div class="container-fluid">
    <section>
        <div class="row">
            <div class="col-md-9">
                <p style="font-weight: bold; color: #1b2a4a">Create New Sub Category</p>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control form-control-lg" id="ssid" placeholder="Search By Category" />
            </div>
        </div>
    </section>
    <section class="mt-4 shadow p-2">
        <div class="row">
            <div class="col-md-2" style="display:none">
                <label><b>Sub Category ID:</b></label>
                @Html.TextBoxFor(x => x.SCId, new { @class = "form-control", @readonly = "True" })
            </div>
            <div class="col-md-3">
                <label><b>Select Category:</b></label>
                @Html.TextBoxFor(x => x.CId, new { @class = "form-control form-control-lg" })
                @Html.HiddenFor(x => x.CategoryName, new { @class = "form-control" })
            </div>
            <div class="col-md-5">
                <label><b>Sub Category Name:</b></label>
                @Html.TextBoxFor(x => x.SubCategoryName, new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <input type="submit" class="btn form-control" onclick="SaveSubCategory()" value="Save Sub Category" style="background-color: #1b2a4a; color: white; margin-top: 24px" />
            </div>
            <div class="col-md-2">
                <input type="submit" class="btn btn-primary form-control" onclick="Refresh()" value="Refresh History" style="margin-top: 24px" />
            </div>
        </div>
    </section>
    <section>
        <table class="table table-sm table-bordered table-hover" id="stbl">
            <thead>
                <tr style="background-color: #077A7D" class="text-white">
                    <td style="background-color: #1b2a4a; width: 10%; display: none" class="text-white"><b>ID</b></td>
                    <td style="background-color: #1b2a4a; width: 20%" class="text-white"><b>Category</b></td>
                    <td style="background-color: #1b2a4a; width: 10%" class="text-white"><b>SC-ID</b></td>
                    <td style="background-color: #1b2a4a; width: 35%" class="text-white"><b>Name</b></td>
                    <td style="background-color: #1b2a4a; width: 5%" class="text-white"><b><i class="fa fa-remove"></i></b></td>
                    <td style="background-color: #1b2a4a; width: 5%" class="text-white"><b><i class="fa fa-pencil"></i></b></td>
                </tr>
            </thead>
            <tbody class="sbody"></tbody>
        </table>
    </section>
</div>
<style>
    p {
        font-size: 28px;
    }

    thead tr td {
        font-size: 14px;
    }

    tbody tr td {
        font-size: 12px;
        font-weight: bold;
    }

    @@media(max-width: 600px) {
        p {
            font-size: 18px;
        }

        thead tr td {
            font-size: 12px;
        }

        tbody tr td {
            font-size: 10px;
            font-weight: bold;
        }
    }
</style>
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>

<link href="~/Content/KendoUI/default-ocean-blue.css" rel="stylesheet" />
<script src="~/Content/KendoUI/jszip.min.js"></script>
<script src="~/Content/KendoUI/kendo.all.min.js"></script>
<script>
    $(document).ready(function () {

        var dataSource = new kendo.data.DataSource({
            transport: {
                read: {
                    url: "/Product/GetCategory",
                    dataType: "json"
                }
            }
        });

        $("#CId").kendoMultiColumnComboBox({
            dataTextField: "CategoryName",
            dataValueField: "CId",
            height: 450,
            columns: [
                { field: "CId", title: "ID", width: 50 },
                { field: "CategoryName", title: "Category", width: 350 }
            ],
            filter: "contains",
            filterFields: ["CId", "CategoryName"],
            dataSource: dataSource,
            change: function () {
                var selectedItem = this.dataItem(this.selectedIndex);
                if (selectedItem) {
                    $("#CategoryName").val(selectedItem.CategoryName);
                }
            }
        });
        //####################################################################################################
        //####################################################################################################
        $("#ssid").kendoMultiColumnComboBox({
            dataTextField: "CategoryName",
            dataValueField: "CId",
            height: 450,
            columns: [
                { field: "CId", title: "ID", width: 50 },
                { field: "CategoryName", title: "Category", width: 350 }
            ],
            filter: "contains",
            filterFields: ["CId", "CategoryName"],
            dataSource: dataSource,
            change: function () {
                var selectedItem = this.dataItem(this.selectedIndex);
                if (selectedItem) {
                    loadData();
                }
            }
        });
        loadData();
    });

</script>
<script>
    function SaveSubCategory() {
        //alert();
        let CId = $("#CId").val().trim();
        let CategoryName = $("#CategoryName").val().trim();
        let SubCategoryName = $("#SubCategoryName").val().trim();
        if (CategoryName.length != 0) {
            if (SubCategoryName.length != 0) {
                var empObj = {
                    CId: CId,
                    CategoryName: CategoryName,
                    SubCategoryName: SubCategoryName
                };
                //alert(Barcode + "---" + _saleid + "---" + itemdis + "---" + rate + "---" + qty);
                $.ajax({
                    url: "/Product/AddNewSubCate/",
                    data: JSON.stringify(empObj),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        $("#SubCategoryName").val('');
                        loadData();
                    },
                    error: function (errormessage) {
                        alert(errormessage.responseText);
                    }
                });
            } else {
                alert("Please Enter Sub Category Name");
            }
        } else {
            alert("Please Select Category Name");
        }
    };
    function loadData() {
        var id = 1;
        let CId = $("#ssid").val().trim();
        var empObj = {
            Id: id,
            CId: CId
        };
        $.ajax({
            url: "/Product/SubCategoryList",
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                var html = '';
                $.each(result, function (key, item) {
                    html += '<tr>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.Id + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.CId + '</td>';
                    html += '<td class="aa" style="font-weight:bold">' + item.CategoryName + '</td>';
                    html += '<td class="aa" style="font-weight:bold">' + item.SCId + '</td>';
                    html += '<td class="aa" style="font-weight:bold" contenteditable="true">' + item.SubCategoryName + '</td>';
                    html += '<td class="divhi"> <a href="#" class="btn btn-sm btn-danger form-control" onclick="DeleleNew(' + item.Id + ')"><i class="fa fa-remove"></i></a></td>';
                    html += '<td class="divhi next"> <a href="#" class="btn btn-sm btn-warning form-control"><i class="fa fa-pencil"></i></a></td>';
                    html += '</tr>';
                });
                $('.sbody').html(html);
            },
            error: function (errormessage) {
                //alert(errormessage.responseText);
            }
        });
    };
    function DeleleNew(ID) {
        var ans = confirm("Are you sure you want to delete this Record?");
        if (ans) {
            $.ajax({
                url: "/Product/DeleteSubCate/" + ID,
                type: "POST",
                contentType: "application/ssjson;charset=UTF-8",
                dataType: "json",
                success: function (result) {
                    loadData();
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }
            });
        }
    };
    $("#stbl").on('click', '.next', function () {
        //alert(1);
        var currentRow = $(this).closest("tr");
        var id = currentRow.find("td:eq(0)").text();
        let cid = currentRow.find("td:eq(1)").text();
        let cname = currentRow.find("td:eq(2)").text();
        let scid = currentRow.find("td:eq(3)").text();
        let scname = currentRow.find("td:eq(4)").text();

        let CId = $("#CId").val().trim();
        let CategoryName = $("#CategoryName").val().trim();

        if (CategoryName.length != 0) {
            var ans = confirm("Are you sure you want to Update Category?");
            if (ans) {
                var empObj = {
                    Id: id,
                    CId: CId,
                    CategoryName: CategoryName,
                    SCId: cid,
                    SubCategoryName: scname
                };
                $.ajax({
                    url: "/Product/UpdateSubCate/",
                    data: JSON.stringify(empObj),
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        loadData();
                    },
                    error: function (errormessage) {
                        alert(errormessage.responseText);
                    }
                });
            }
        } else {
            var empObj = {
                Id: id,
                CId: cid,
                CategoryName: cname,
                SCId: cid,
                SubCategoryName: scname
            };
            $.ajax({
                url: "/Product/UpdateSubCate/",
                data: JSON.stringify(empObj),
                type: "POST",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    loadData();
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }
            });
        }
    });
    function Refresh() {
        var _CId = $('#CId').data("kendoMultiColumnComboBox");
        _CId.value(null);
        var _SSID = $('#ssid').data("kendoMultiColumnComboBox");
        _SSID.value(null);
        $("#SubCategoryName").val('');
        loadData();
    }
</script>

