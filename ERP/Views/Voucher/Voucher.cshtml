
@{
    ViewBag.Title = "Voucher";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<style>
    @@media (max-width: 600px) {
        .bb {
            display: none;
        }

        table tr th {
            font-size: 11px;
        }

        table tr td {
            font-size: 11px;
        }
    }

    #loaderOverlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5); /* screen blur */
        z-index: 9999; /* sab se uper */

        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Spinner */
    .spinner {
        width: 60px;
        height: 60px;
        border: 6px solid #f3f3f3;
        border-top: 6px solid #3498db;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>
<div id="loaderOverlay">
    <div class="spinner"></div>
</div>
<section>
    <div class="row bb">
        <div class="col-md-8 col-8">
            <p style="font-weight: bold; font-size: 24px; color: #077A7D">@ViewBag.head</p>
        </div>

    </div>
</section>
<section>
    <input type="hidden" id="toc" /><input type="hidden" id="tod" />
    <input type="hidden" id="AccCode" />
    <input type="hidden" id="AccName" />
    <input type="hidden" id="HeadCode" /><input type="hidden" id="HeadName" />
    <input type="hidden" id="SubHeadCode" /><input type="hidden" id="SubHeadName" />
    <input type="hidden" id="SubSubHeadCode" /><input type="hidden" id="SubSubHeadName" />
    <input type="hidden" id="SubSubSubHeadCode" /><input type="hidden" id="SubSubSubHeadName" />
    <div class="container-fluid shadow">
        <div class="row">
            <div class="col-md-2 col-6">
                <label>Enter Date</label>
                <input type="text" id="date" class="form-control form-control-lg disclass" />
            </div>
            <div class="col-md-1 bb">
                <label>Type</label>
                <input type="text" id="type" class="form-control ss disclass opclass" value="@ViewBag.type" readonly />
            </div>
            <div class="col-md-3 col-6">
                <label>Select Account</label>
                <input type="text" id="acccode" class="form-control form-control-lg disclass" placeholder="Account Register" />
            </div>
            <div class="col-md-1 col-6">
                <label>Enter Debit</label>
                <input type="number" id="dAmt" class="form-control ss disclass opclass" />
            </div>
            <div class="col-md-1 col-6">
                <label>Enter Credit</label>
                <input type="number" id="cAmt" class="form-control ss disclass opclass" />
            </div>
            <div class="col-md-3 col-10">
                <label>Enter Narration</label>
                <input type="text" id="nar" class="form-control ss disclass opclass" />
            </div>
            <div class="col-md-1 col-2">
                <button class="btn btn-primary form-control disclass opclass" style="margin-top:24px" onclick="saveDataInTable()"><span class="fa fa-plus"></span></button>
            </div>
        </div>
    </div>
</section>
<section>
    <div id="div_print" class="ledger-container">
        <div class="ledger-header-container">
            <center>
                <h5 style="color: #4E56C0 "><b>@ERPSolution.Controllers.TblProfileController.Name()</b></h5>
                <h5 style="color: #9B5DE0 "><b>@ERPSolution.Controllers.TblProfileController.Mobile() / @ERPSolution.Controllers.TblProfileController.Phone()</b></h5>
                <h6 style="color: #5C3E94"><b>@ERPSolution.Controllers.TblProfileController.Address() </b></h6>
            </center>
        </div>
        <table class="table table-sm table-hover mt-2" id="itemtbl">
            <thead>
                <tr class="">
                    <th style="display:none;">Id</th>
                    <th style="display:none;">Voucher Id</th>
                    <th style="display:none;">VoucherType</th>
                    <th style="display:none;">HeadCode</th>
                    <th style="display:none;">HeadName</th>
                    <th style="display:none;">SubHeadCode</th>
                    <th style="display:none;">SubHeadName</th>
                    <th style="display:none;">SubSubHeadCode</th>
                    <th style="display:none;">SubSubHeadName</th>
                    <th style="display:none;">SubSubSubHeadCode</th>
                    <th style="display:none;">SubSubSubHeadName</th>
                    <th style="display:none;">Acc Code</th>
                    <th style="background-color: #077A7D;color:white;width:30%">Account</th>
                    <th style="background-color: #077A7D; color: white; width: 30%">Narration</th>
                    <th style="background-color: #077A7D; color: white; width: 15%">Debit</th>
                    <th style="background-color: #077A7D; color: white; width: 15%">Credit</th>
                    <th style="display:none;">Date</th>
                    <th style="display:none;">Status</th>
                    <th class="hii" style="background-color: #077A7D; color: white; width: 10%">X</th>
                </tr>
            </thead>
            <tbody class="body"></tbody>
            <tbody class="tbodyl"></tbody>
            <tfoot>
                <tr class="bg-light text-dark"  style="border-top: 2px solid #808080; border-bottom: 2px solid #808080">
                    <td style="background-color:#d1cdcd4d" colspan="2"></td>
                    <td  style="background-color:#d1cdcd4d"><span style="font-weight:bold;font-size:11px" id="totalCredit">0</span></td>
                    <td style="background-color:#d1cdcd4d"><span style="font-weight:bold;font-size:11px" id="totalDebit">0</span></td>
                    <td  style="background-color:#d1cdcd4d" class="hii"></td>
                </tr>
                <tr class="bg-light text-dark hii">
                    <td colspan="3"><b>Difference:</b></td>
                    <td class="hii" colspan="2"><span style="font-weight:bold;font-size:12px" id="totalDiff">0</span></td>
                </tr>
            </tfoot>
        </table>
        <div class="signature-container">
            <p class="signature">Authorized By: ____________________</p>
            <p class="signature">Received By: ________________________</p>
        </div>
    </div>
</section>
<div class="SaveBtn">
    <br /><br />
    <div class="row">
        <div class="col-md-2 col-2">
            <button class="btn btn-sm mbtn form-control" onclick="enableFun()" style="background-color:rgba(222, 217, 217, 0.61)"><i style="font-size:19px;font-weight:bold" class="fas fa-plus"></i></button>
        </div>
        <div class="col-md-2 col-2">
            <a href="#" class="btn btn-sm btn-dark form-control" onclick="loadDatad()"><span class="fa fa-search"></span></a>
        </div>
        <div class="col-md-2 col-2">
            <a href="#" onclick="EditenableFun()" style="" class="btn btn-sm btn-warning form-control"><span class="fa fa-pencil"></span></a>
        </div>
        <div class="col-md-2 col-2">
            <a href="#" onclick="" style="" class="btn btn-sm btn-primary form-control"><span class="fa fa-print"></span></a>
        </div>
        <div class="col-md-4 col-4">
            <input type="submit" class="btn btn-sm form-control" value="Post @ViewBag.type" onclick="saveInvoice('div_print')" style="background-color: #077A7D; color: white;" />
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
<link href="~/Content/KendoUI/default-ocean-blue.css" rel="stylesheet" />
<script src="~/Content/KendoUI/jszip.min.js"></script>
<script src="~/Content/KendoUI/kendo.all.min.js"></script>
<script>
    $(window).on("load", function () {
        $("#loaderOverlay").hide();               // Loader hide
        $("body").css("pointer-events", "auto");  // Body clickable again
    });
    $(document).ready(function () {
        $("#date").kendoDatePicker({ value: new Date(), format: "yyyy-MM-dd", });
        //$("#vdate").kendoDatePicker({ value: new Date(), format: "yyyy-MM-dd", });
        $(".ledger-header-container").hide();
        $(".signature-container").hide();
        disableFun();
        var dataSource = new kendo.data.DataSource({
            transport: {
                read: {
                    url: "/Voucher/getAccounts",
                    dataType: "json"
                }
            },
            schema: {
                parse: function (response) {
                    return $.map(response, normalizeJsonKeys);
                }
            }
        });
        $("#acccode").kendoMultiColumnComboBox({
            dataTextField: "AccName",
            dataValueField: "AccCode",
            height: 450,
            columns: [
                { field: "AccName", title: "Account", width: 350 },
            ],
            filter: "contains",
            filterFields: ["AccCode", "AccName"],
            dataSource: dataSource,
            change: function () {
                var selectedItem = this.dataItem();

                if (!selectedItem || selectedItem.AccCode == null || !selectedItem.AccName) {
                    $("#AccCode, #AccName, #HeadCode, #HeadName, #SubHeadCode, #SubHeadName, #SubSubHeadCode, #SubSubHeadName, #SubSubSubHeadCode, #SubSubSubHeadName").val("");
                    this.value("");
                    return;
                }

                $("#AccCode").val(selectedItem.AccCode);
                $("#AccName").val(selectedItem.AccName);
                $("#HeadCode").val(selectedItem.HeadCode ?? "");
                $("#HeadName").val(selectedItem.HeadName ?? "");
                $("#SubHeadCode").val(selectedItem.SubHeadCode ?? "");
                $("#SubHeadName").val(selectedItem.SubHeadName ?? "");
                $("#SubSubHeadCode").val(selectedItem.SubSubHeadCode ?? "");
                $("#SubSubHeadName").val(selectedItem.SubSubHeadName ?? "");
                $("#SubSubSubHeadCode").val(selectedItem.SubSubSubHeadCode ?? "");
                $("#SubSubSubHeadName").val(selectedItem.SubSubSubHeadName ?? "");
            }
        });
    });
    function normalizeJsonKeys(item) {
        if (!item || typeof item !== "object") {
            return item;
        }

        Object.keys(item).forEach(function (key) {
            var pascalKey = key.charAt(0).toUpperCase() + key.slice(1);
            if (item[pascalKey] === undefined) {
                item[pascalKey] = item[key];
            }
        });

        return item;
    }
    //#################################################################
    $("#itemtbl").on('keyup', '.next', function () {
        //if (event.keyCode === 13) {
        updateSums();
        sum();
    });
    function updateSums() {
        let totalCredit = 0;
        let totalDebit = 0;
        let totalDiff = 0;
        $('#itemtbl tbody tr').each(function () {
            let credit = parseFloat($(this).find('td:eq(14)').text()) || 0;
            let debit = parseFloat($(this).find('td:eq(15)').text()) || 0;
            totalCredit += credit;
            totalDebit += debit;
        });
        $('#totalCredit').text(totalCredit.toFixed(2));
        $('#totalDebit').text(totalDebit.toFixed(2));
        totalDiff = parseInt(parseInt(totalCredit.toFixed(2)) - parseInt(totalDebit.toFixed(2)));
        $('#totalDiff').text(totalDiff.toFixed(2));
        $('#toc').val(totalCredit.toFixed(2));
        $('#tod').val(totalDebit.toFixed(2));
    }
    function saveDataInTable() {

        var accountCode = $("#AccCode").val();
        var accountName = $("#AccName").val();

        if (!accountCode || !accountName) {
            alert("Please select a valid account from the list.");
            $("#acccode").data("kendoMultiColumnComboBox").focus();
            return;
        }

        let debit = $("#dAmt").val().trim() || 0;
        let credit = $("#cAmt").val().trim() || 0;
        let rowHtml = `
        <tr class="custom-row-class">

            <td style="display:none">0</td>
            <td style="display:none">0</td>
            <td style="display:none">${$("#type").val()}</td>

            <td style="display:none">${$("#HeadCode").val()}</td>
            <td style="display:none">${$("#HeadName").val()}</td>

            <td style="display:none">${$("#SubHeadCode").val()}</td>
            <td style="display:none">${$("#SubHeadName").val()}</td>

            <td style="display:none">${$("#SubSubHeadCode").val()}</td>
            <td style="display:none">${$("#SubSubHeadName").val()}</td>

            <td style="display:none">${$("#SubSubSubHeadCode").val()}</td>
            <td style="display:none">${$("#SubSubSubHeadName").val()}</td>

            <td style="display:none">${accountCode}</td>

            <td>${accountName}</td>
            <td>${$("#nar").val()}</td>

            <td class="next">${debit}</td>
            <td class="next">${credit}</td>

            <td style="display:none">${$("#date").val()}</td>
            <td >0</td>

            <td>
                <input type="submit"
                       class="btn btn-sm btn-danger"
                       value="x"
                       onclick="Remove(this)">
            </td>

        </tr>`;

        $("#itemtbl tbody.body").append(rowHtml);
        loadDatad();
        updateSums();

        // Clear fields
        $("#dAmt").val('');
        $("#cAmt").val('');
        $("#nar").val('');
        $('.tbodyl').html(''); var acccode = $('#acccode').data("kendoMultiColumnComboBox");
        acccode.value("");
        acccode.focus();
    }

    function Remove(button) {
        //Determine the reference of the Row using the Button.
        var row = $(button).closest("TR");
        var name = $("TD", row).eq(12).html();
        if (confirm("Do you want to delete: " + name)) {
            //Get the reference of the Table.
            var table = $("#itemtbl")[0];
            table.deleteRow(row[0].rowIndex);
            loadDatad();
            updateSums();
        }
    };
    function saveInvoice(printpage) {
        $("#loaderOverlay").show();
        $("body").css("pointer-events", "none");
        let _toc = $("#toc").val().trim();
        let _tod = $("#tod").val().trim();
        let _date = $("#date").val();
        var orderArr = [];
        orderArr.length = 0;
        $.each($("#itemtbl tbody tr"), function () {
            orderArr.push({
                Id: $(this).find('td:eq(0)').html(),
                Voucher_Id: $(this).find('td:eq(1)').html(),
                VoucherType: $(this).find('td:eq(2)').html(),
                HeadCode: $(this).find('td:eq(3)').html(),
                HeadName: $(this).find('td:eq(4)').html(),
                SubHeadCode: $(this).find('td:eq(5)').html(),
                SubHeadName: $(this).find('td:eq(6)').html(),
                SubSubHeadCode: $(this).find('td:eq(7)').html(),
                SubSubHeadName: $(this).find('td:eq(8)').html(),
                SubSubSubHeadCode: $(this).find('td:eq(9)').html(),
                SubSubSubHeadName: $(this).find('td:eq(10)').html(),
                Account_Code: $(this).find('td:eq(11)').html(),
                Account_Name: $(this).find('td:eq(12)').html(),
                Narration: $(this).find('td:eq(13)').html(),
                Debit: $(this).find('td:eq(14)').html(),
                Credit: $(this).find('td:eq(15)').html(),
                Date: $(this).find('td:eq(16)').html(),
                Status: $(this).find('td:eq(17)').html()
            });
        });
        var data = JSON.stringify({
            udate: _date,
            order: orderArr
        });
        if (orderArr.length != 0) {
            if (_toc == _tod) {
                $.ajax({
                    url: "/Voucher/SaveVoucher",
                    data: data,
                    type: "POST",
                    contentType: "application/json;charset=utf-8",
                    dataType: "json",
                    success: function (result) {
                        $("#loaderOverlay").hide();
                        $("body").css("pointer-events", "auto");
                        $("#HeadCode").val('');
                        $("#HeadName").val('');
                        $("#SubHeadCode").val('');
                        $("#SubHeadName").val('');
                        $("#SubSubHeadCode").val('');
                        $("#SubSubHeadName").val('');
                        $("#SubSubSubHeadCode").val('');
                        $("#SubSubSubHeadName").val('');
                        $("#AccCode").val('');
                        $("#AccName").val('');
                        $("#dAmt").val('');
                        $("#cAmt").val('');
                        $("#nar").val('');
                        $('.body').html('');
                        $('.tbodyl').html(''); var acccode = $('#acccode').data("kendoMultiColumnComboBox");
                        acccode.value(null);
                        acccode.focus();
                        alert("Voucher Posted Successfully");
                        loadDatad();
                    },
                    error: function (errormessage) {
                        alert(errormessage.responseText);
                    }
                });
            } else {
                alert("Incomplete Your Entries");
            }

        } else {
            alert("Your Post Is Empty");
        }
    };
    function loadDatad() {

        let vty = $("#type").val().trim();
        let vda = $("#date").val().trim();
        //var item1 = $('#date').data("kendoDatePicker");
        //item1.value(vda);
        //alert(vty + vda);
        var empObj = {
            VoucherType: vty,
            Date: vda
        };
        $.ajax({
            url: "/Voucher/VList",
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                result = $.map(result, normalizeJsonKeys);
                var html = '';
                $.each(result, function (key, item) {
                    var dt = new Date(item.Date);
                    var dtfinal = addleadingzero(dt.getFullYear(), 4) + '-' + addleadingzero(dt.getMonth() + 1, 2) + '-' + addleadingzero(dt.getDate(), 2)
                    html += '<tr>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.Id + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.Voucher_Id + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.VoucherType + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.HeadCode + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.HeadName + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.SubHeadCode + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.SubHeadName + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.SubSubHeadCode + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.SubSubHeadName + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.SubSubSubHeadCode + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.SubSubSubHeadName + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.Account_Code + '</td>';
                    html += '<td class="aa" style="font-weight:bold">' + item.Account_Name + '</td>';
                    html += '<td class="aa" style="font-weight:bold">' + item.Narration + '</td>';
                    html += '<td class="aa next" style="font-weight:bold">' + item.Debit + '</td>';
                    html += '<td class="aa next" style="font-weight:bold">' + item.Credit + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + dtfinal + '</td>';
                    html += '<td class="aa" style="font-weight:bold;display:none">' + item.Status + '</td>';
                    html += '<td class="aa hii" style="font-weight:bold"><a href="#" class="btn btn-sm btn-danger" onclick="DeleleOld(' + item.Id + ')">X</a></td>';
                    html += '</tr>';
                });
                $('.tbodyl').html(html);
                updateSums();
            },
            error: function (errormessage) {
                //alert(errormessage.responseText);
            }
        });
    };
    function DeleleOld(ID) {
        var ans = confirm("Are you sure you want to delete this Record?");
        if (ans) {
            $.ajax({
                url: "/Voucher/DeleteOld/" + ID,
                data: { ID: ID },
                type: "POST",
                dataType: "json",
                success: function (result) {
                    loadDatad();
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }
            });
        }
    };
    function addleadingzero(number, size) {
        var s = "0000" + number;
        return s.substr(s.length - size);
    };
    function disableFun() {
        const elements = document.querySelectorAll(".disclass");

        // Disable each one
        elements.forEach(element => {
            element.disabled = true;
            //element.style.opacity = "0.2";
        });
        opFun();
    };
    function opFun() {
        const elements = document.querySelectorAll(".opclass");

        // Disable each one
        elements.forEach(element => {
            element.style.opacity = "0.2";
        });
    };
    //EditenableFun
    function EditenableFun() {

        //$("#totalCredit").text(''); $("#totalDebit").text(''); $("#toc").val('');
        //$("#toc").val(''); $("#tod").val('');
        //$('.body').html('');
        //$('.tbodyl').html('');
        //updateSums();
        var acccode = $('#acccode').data("kendoMultiColumnComboBox");
        acccode.value(null);
        acccode.focus();
        const elements = document.querySelectorAll(".disclass");
        elements.forEach(element => {
            // Enable the native input element (in case it's inside the Kendo widget)
            const inputElement = element.querySelector("input") || element; // Find the input inside or use the element itself
            inputElement.disabled = false;
            inputElement.style.opacity = "1";

            // Enable Kendo UI widget using jQuery .data() method
            // Check if the element is a Kendo ComboBox, DatePicker, etc.
            if ($(inputElement).data("kendoDatePicker")) {
                $(inputElement).data("kendoDatePicker").enable(true); // For DatePicker
            } else if ($(inputElement).data("kendoMultiColumnComboBox")) {
                $(inputElement).data("kendoMultiColumnComboBox").enable(true); // For MultiColumnComboBox
            }
        });
        const editableCells = document.querySelectorAll("td.next");

        editableCells.forEach(cell => {
            cell.contentEditable = "true";       // Make the cell editable
            cell.classList.add("editable");      // Optional: highlight the cell
        });
    };
    function enableFun() {

        //$("#totalCredit").text(''); $("#totalDebit").text(''); $("#toc").val('');
        //$("#toc").val(''); $("#tod").val('');
        $('.body').html('');
        $('.tbodyl').html('');
        updateSums();
        var acccode = $('#acccode').data("kendoMultiColumnComboBox");
        acccode.value(null);
        acccode.focus();
        const elements = document.querySelectorAll(".disclass");
        elements.forEach(element => {
            // Enable the native input element (in case it's inside the Kendo widget)
            const inputElement = element.querySelector("input") || element; // Find the input inside or use the element itself
            inputElement.disabled = false;
            inputElement.style.opacity = "1";

            // Enable Kendo UI widget using jQuery .data() method
            // Check if the element is a Kendo ComboBox, DatePicker, etc.
            if ($(inputElement).data("kendoDatePicker")) {
                $(inputElement).data("kendoDatePicker").enable(true); // For DatePicker
            } else if ($(inputElement).data("kendoMultiColumnComboBox")) {
                $(inputElement).data("kendoMultiColumnComboBox").enable(true); // For MultiColumnComboBox
            }
        });
        const editableCells = document.querySelectorAll("td.next");

        editableCells.forEach(cell => {
            cell.contentEditable = "true";       // Make the cell editable
            cell.classList.add("editable");      // Optional: highlight the cell
        });
    };
    function printdiv(printpage) {
        $(".ledger-header-container").show();
        $(".signature-container").show();
        $(".hii").hide();
        var printStyles = document.createElement('style');
        printStyles.innerHTML = `
            @@media print{
            table {
                border-collapse: collapse; /* Ensures borders are collapsed into a single line */
                width: 100%; /* Make the table take up the full width */
            }

                table thead tr th {
                    font-size: 14px;
                    font-weight:bold;
                    color:black;
                    border: 1px solid black; /* Adds a black border around each cell */
                }

                table tbody tr td {
                    font-size: 12px;
                    font-weight:bold;
                    color:black;
                    border: 1px solid black; /* Adds a black border around each cell */
                }
                table thead tr {
                    font-size: 14px;
