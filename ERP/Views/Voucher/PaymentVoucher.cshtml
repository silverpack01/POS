
@{
    ViewBag.Title = "CR Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div id="loaderOverlay">
    <div class="spinner"></div>
</div>
<style>
    @@media (max-width: 600px) {
        table tr th {
            font-size: 12px;
        }

        table tbody tr td {
            font-size: 11px;
        }
    }

    #loaderOverlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5); /* screen blur */
        z-index: 9999; /* sab se uper */

        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Spinner */
    .spinner {
        width: 60px;
        height: 60px;
        border: 6px solid #f3f3f3;
        border-top: 6px solid #3498db;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<section>
    <div class="container-fluid shadow p-1">
        <div class="row">
            <div class="col-md-4 col-6 mt-2">
                <input type="text" id="date" class="form-control form-control-lg disclass" />
            </div>
            <div class="col-md-4 col-6 mt-2">
                <select class="form-control disclass" id="type" onchange="addshow()">
                    <option value="">Type</option>
                    <option value="CPV">Cash Payment</option>
                    <option value="CRV">Cash Received</option>
                    <option value="BPV">Bank Payment</option>
                    <option value="BRV">Bank Received</option>
                </select>
            </div>
            <div class="col-md-4 col-12 mt-2">
                <input type="hidden" id="bankac" />
                <input type="text" id="bankname" class="form-control form-control-lg disclass" />
            </div>
        </div>
    </div>
</section>
<section class="mt-2">
    <input type="hidden" id="AccCode" /><input type="hidden" id="AccName" />
    <input type="hidden" id="HeadCode" /><input type="hidden" id="HeadName" />
    <input type="hidden" id="SubHeadCode" /><input type="hidden" id="SubHeadName" />
    <input type="hidden" id="SubSubHeadCode" /><input type="hidden" id="SubSubHeadName" />
    <input type="hidden" id="SubSubSubHeadCode" /><input type="hidden" id="SubSubSubHeadName" />
    <div class="container-fluid shadow">
        <div class="row">
            <div class="col-md-6 col-6">
                <label>Select Account</label>
                <input type="text" id="acccode" class="form-control form-control-lg disclass" placeholder="Account Register" />
            </div>
            <div class="col-md-2 col-6">
                <label> Amount</label>
                <input type="text" id="Amt" class="form-control ss disclass opclass" />
            </div>
            <div class="col-md-3 col-6">
                <label>Enter Narration</label>
                <input type="text" id="nar" class="form-control ss disclass opclass" />
            </div>
            <div class="col-md-1 col-6">
                <button class="btn btn-primary form-control disclass opclass" style="margin-top:24px" onclick="saveDataInTable()"><i class="fa fa-save"></i></button>
            </div>
            <div class="col-md-12 col-12 mt-2">
                <input type="text" id="bal" class="form-control ss disclass opclass" style="color:red;font-weight:bold" readonly/>
            </div>
        </div>
        <br />
    </div>
</section>
<section>
    <table class="table table-sm table-hover" id="itemtbl">
        <thead>
            <tr class="">
                <th style="background-color: #077A7D;color:white">****</th>
                <th style="display:none;">HeadCode</th>
                <th style="display:none;">HeadName</th>
                <th style="display:none;">SubHeadCode</th>
                <th style="display:none;">SubHeadName</th>
                <th style="display:none;">SubSubHeadCode</th>
                <th style="display:none;">SubSubHeadName</th>
                <th style="display:none;">Acc Code</th>
                <th style="background-color: #077A7D;color:white">Account</th>
                <th style="background-color: #077A7D; color: white">Narration</th>
                <th colspan="2" style="background-color: #077A7D; color: white">Amount</th>
                <th style="display:none;">RefCode</th>
                <th style="display:none;">RefName</th>
                <th style="display:none;">Date</th>
            </tr>
        </thead>
        <tbody class="body"></tbody>
        <tbody class="tbodyl"></tbody>
        <tfoot>
            <tr style="border-top: 2px solid #808080; border-bottom: 2px solid #808080">
                <td style="background-color:#d1cdcd4d" colspan="3">--------</td>
                <td style="background-color: #d1cdcd4d;" colspan="2"><span style="font-weight:bold; font-size: 16px" class="totalCredit">0</span></td>
            </tr>
        </tfoot>
    </table>
</section>
<div class="SaveBtns">
    <div class="row">
        <div class="col-md-3 col-2">
            <a href="#" style="" class="btn btn-info form-control" onclick="enableFun()"><i class="fa fa-plus"></i></a>
        </div>
        <div class="col-md-3 col-2">
            <a href="#" class="btn btn-primary form-control" onclick="printVoucher()"><i class="fa fa-print"></i></a>
        </div>
        <div class="col-md-3 col-4">
            <a href="#" class="btn btn-dark form-control" onclick="loadDatad()"><i class="fa fa-search"></i></a>
        </div>
        <div class="col-md-3 col-4">
            <button type="button" id="saveBtn" class="btn form-control disclass opclass" style="background-color: #077A7D; color: white;">Post All</button>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<script src="~/Scripts/jquery-ui-1.14.1.min.js"></script>
<script src="~/JsFiles/paymentJs.js?v=@DateTime.Now.Ticks"></script>
<link href="~/Content/KendoUI/default-ocean-blue.css" rel="stylesheet" />
<script src="~/Content/KendoUI/jszip.min.js"></script>
<script src="~/Content/KendoUI/kendo.all.min.js"></script>
<style>
    .ss {
        border: 2px solid #077A7D;
        background-color: #f9f9f9;
    }
</style>

@*print voucher modal*@

<div class="modal fade" id="printModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><b>Print Voucher</b></h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="report-container" id="myDiv">
                    <div>
                        <center>
                            <b style="font-size:24px "><b>@ERPSolution.Controllers.TblProfileController.Name()</b></b><br />
                            <b style="font-size: 15px "><b>@ERPSolution.Controllers.TblProfileController.Mobile() / @ERPSolution.Controllers.TblProfileController.Phone()</b></b><br />
                            <b style="font-size: 15px"><b>@ERPSolution.Controllers.TblProfileController.Address() </b></b><br />
                            <b style="font-size: 12px"><b>Voucher Date: <span id="tdate"></span></b></b><br />
                            <b style="font-size: 12px"><b>Voucher Type: <span id="tcate"></span></b></b><br />
                        </center>
                    </div>
                    <table class="table table-sm table-hover" id="printtbl">
                        <thead>
                            <tr class="">
                                <th style="background-color: #077A7D;color:white">****</th>
                                <th style="background-color: #077A7D;color:white">Account</th>
                                <th style="background-color: #077A7D; color: white">Narration</th>
                                <th colspan="2" style="background-color: #077A7D; color: white">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="printbody"></tbody>
                        <tfoot>
                            <tr style="border-top: 2px solid #808080; border-bottom: 2px solid #808080">
                                <td style="background-color:#d1cdcd4d" colspan="3">--------</td>
                                <td style="background-color: #d1cdcd4d;" colspan="2"><span style="font-weight:bold; font-size: 16px" class="totalCredit">0</span></td>
                            </tr>
                        </tfoot>
                    </table>


                </div>
            </div>
            <div class="modal-footer">
                <a href="#" onclick="generatePDF()" class="btn btn-success w-20"><i class="fab fa-whatsapp fa-lg"></i></a>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>

    async function generatePDF() {
        $("#loaderOverlay").show();
        $("body").css("pointer-events", "none");
        const { jsPDF } = window.jspdf;

        let div = document.getElementById("myDiv");

        // Convert HTML to canvas
        let canvas = await html2canvas(div, { scale: 2 });
        let imgData = canvas.toDataURL("image/png");

        let pdf = new jsPDF("p", "mm", "a4");

        let pageWidth = pdf.internal.pageSize.getWidth();
        let pageHeight = pdf.internal.pageSize.getHeight();

        let imgWidth = pageWidth;
        let imgHeight = (canvas.height * imgWidth) / canvas.width;

        let heightLeft = imgHeight;
        let position = 0;

        // First page
        pdf.addImage(imgData, "PNG", 0, position, imgWidth, imgHeight);
        heightLeft -= pageHeight;

        // Extra pages
        while (heightLeft > 0) {
            position = heightLeft - imgHeight;
            pdf.addPage();
            pdf.addImage(imgData, "PNG", 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;
        }

        pdf.save("Ledger.pdf");
        $("#loaderOverlay").hide();
        $("body").css("pointer-events", "auto");
    };


</script>
